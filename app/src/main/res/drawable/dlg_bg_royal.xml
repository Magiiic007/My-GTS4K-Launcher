<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF05230F" />
            <corners android:radius="34dp" />
            <stroke android:width="2dp" android:color="#CCD9A93A" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF0D4220" android:endColor="#FF062711" />
            <corners android:radius="28dp" />
            <stroke android:width="3dp" android:color="#FFD9A93A" />
        </shape>
    </item>
</layer-list>
