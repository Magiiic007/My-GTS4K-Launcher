<?xml version="1.0" encoding="utf-8"?>
<!-- A header button: a soft pill, outlined in gold when the remote is on it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33E0B040" />
            <stroke android:width="3dp" android:color="#FFE0B040" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#661A2438" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
