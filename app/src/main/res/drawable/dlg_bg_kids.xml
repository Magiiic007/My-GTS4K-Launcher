<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFE58FA3" />
            <corners android:radius="34dp" />
            <stroke android:width="2dp" android:color="#CCFFF0CC" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFBD3DE" android:endColor="#FFEFA6BB" />
            <corners android:radius="28dp" />
            <stroke android:width="3dp" android:color="#FFFFF0CC" />
        </shape>
    </item>
</layer-list>
