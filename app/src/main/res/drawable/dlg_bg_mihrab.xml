<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF08122A" />
            <corners android:radius="34dp" />
            <stroke android:width="2dp" android:color="#CCE0B960" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF142A56" android:endColor="#FF0B1A3A" />
            <corners android:radius="28dp" />
            <stroke android:width="3dp" android:color="#FFE0B960" />
        </shape>
    </item>
</layer-list>
