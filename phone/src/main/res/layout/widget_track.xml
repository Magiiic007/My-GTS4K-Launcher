            <TextView android:id="@+id/tk_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tk_b2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="2dp" android:background="@drawable/w_tile" android:gravity="center" android:orientation="vertical" android:padding="2dp">
            <TextView android:id="@+id/tk_d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC9CCE0" android:textSize="20sp" />
            <TextView android:id="@+id/tk_n2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/tk_t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tk_b3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="2dp" android:background="@drawable/w_tile" android:gravity="center" android:orientation="vertical" android:padding="2dp">
            <TextView android:id="@+id/tk_d3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC9CCE0" android:textSize="20sp" />
            <TextView android:id="@+id/tk_n3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/tk_t3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tk_b4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="2dp" android:background="@drawable/w_tile" android:gravity="center" android:orientation="vertical" android:padding="2dp">
            <TextView android:id="@+id/tk_d4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC9CCE0" android:textSize="20sp" />
            <TextView android:id="@+id/tk_n4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/tk_t4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
