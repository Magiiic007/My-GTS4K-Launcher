<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="8dp">

    <!-- the date on the right; the countdown to the next adhan or iqama on the left -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.1"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:layoutDirection="rtl" android:orientation="horizontal">
        <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="34sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@+id/w_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/w_hijri" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFE9DDBB" android:textSize="13sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/w_sun" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:layoutDirection="ltr" android:orientation="vertical">
            <Chronometer android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFE8B84A" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_until" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- the five prayers, tap one to mark it prayed; Fajr is on the right -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5" android:layout_marginTop="2dp"
        android:layoutDirection="rtl" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_b0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="2dp" android:background="@drawable/w_tile" android:gravity="center" android:orientation="vertical" android:padding="2dp">
            <TextView android:id="@+id/w_d0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC9CCE0" android:textSize="18sp" />
            <TextView android:id="@+id/w_n0" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/w_t0" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_b1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="2dp" android:background="@drawable/w_tile" android:gravity="center" android:orientation="vertical" android:padding="2dp">
            <TextView android:id="@+id/w_d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC9CCE0" android:textSize="18sp" />
            <TextView android:id="@+id/w_n1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/w_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_b2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="2dp" android:background="@drawable/w_tile" android:gravity="center" android:orientation="vertical" android:padding="2dp">
            <TextView android:id="@+id/w_d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC9CCE0" android:textSize="18sp" />
            <TextView android:id="@+id/w_n2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/w_t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_b3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="2dp" android:background="@drawable/w_tile" android:gravity="center" android:orientation="vertical" android:padding="2dp">
            <TextView android:id="@+id/w_d3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC9CCE0" android:textSize="18sp" />
            <TextView android:id="@+id/w_n3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/w_t3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_b4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="2dp" android:background="@drawable/w_tile" android:gravity="center" android:orientation="vertical" android:padding="2dp">
            <TextView android:id="@+id/w_d4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFC9CCE0" android:textSize="18sp" />
            <TextView android:id="@+id/w_n4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" />
            <TextView android:id="@+id/w_t4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- the radio in one row: the station and previous, play or stop, next -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.9" android:layout_marginTop="4dp"
        android:background="@drawable/widget_bar" android:gravity="center_vertical" android:layoutDirection="rtl" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/w_wc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="🚻 الخلاء"
            android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:background="@drawable/w_chip"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
        <TextView android:id="@+id/w_station" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFD5D9EC" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:layout_weight="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:layoutDirection="ltr" android:orientation="horizontal">
            <ImageView android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="match_parent" android:padding="8dp" android:src="@drawable/ic_w_prev" />
            <ImageView android:id="@+id/w_play" android:layout_width="46dp" android:layout_height="match_parent" android:padding="6dp" android:src="@drawable/ic_w_play" />
            <ImageView android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="match_parent" android:padding="8dp" android:src="@drawable/ic_w_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
