<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tb_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="8dp">
    <TextView android:id="@+id/tb_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="16sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:gravity="center" android:textStyle="bold" android:background="@drawable/w_chip" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginBottom="4dp">
        <TextView android:id="@+id/tb_count" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_circle"
            android:gravity="center" android:maxLines="1" android:textColor="#FFE8B84A" android:textSize="40sp" android:textStyle="bold" android:layoutDirection="ltr"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="40sp" android:autoSizeStepGranularity="1sp" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="rtl" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/tb_today" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textColor="#FFB8C2DC" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/tb_reset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↺ جديد" android:textColor="#FFFFFFFF" android:textSize="11sp"
            android:background="@drawable/w_chip" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
    </LinearLayout>
</LinearLayout>
